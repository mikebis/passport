# Public OAuth Web application client ID. Never put a client secret here.
# Copy to .env.local and restart your own Vite server after configuring Google.
VITE_GOOGLE_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID.apps.googleusercontent.com

# Optional public GA4 measurement ID (G-...), not a secret or an OAuth client ID.
# Empty disables analytics. Development/local previews always exclude analytics.
# Configure the property and privacy requirements in README before enabling.
VITE_GOOGLE_ANALYTICS_ID=
